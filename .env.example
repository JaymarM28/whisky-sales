# ── Base de datos ──
DATABASE_URL="postgresql://user:password@localhost:5432/whisky_db"
# Conexión directa (sin pooler) usada por Prisma para migraciones; en local puede ser igual a DATABASE_URL
DIRECT_URL="postgresql://user:password@localhost:5432/whisky_db"

# ── Auth ── (obligatorio: el backend no arranca sin JWT_SECRET)
JWT_SECRET="cambia_esto_por_un_secreto_seguro"
JWT_EXPIRES_IN="7d"

# ── Servidor ──
PORT=3000
NODE_ENV=development
# Orígenes permitidos por CORS, separados por coma
ALLOWED_ORIGINS="http://localhost:4200"
# URL pública del frontend (se usa en el enlace de recuperación de PIN)
FRONTEND_URL="http://localhost:4200"

# ── Email (Resend) ──
RESEND_API_KEY=""
EMAIL_FROM="JM Liquors <noreply@tudominio.com>"

# ── Comprobantes (Cloudinary) ──
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
