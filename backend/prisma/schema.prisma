generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Tenant {
  id                 String              @id @default(cuid())
  name               String
  slug               String              @unique
  active             Boolean             @default(true)
  createdAt          DateTime            @default(now())
  commissionPayments CommissionPayment[]
  deliveries         Delivery[]
  products           Product[]
  purchases          Purchase[]
  returns            StockReturn[]
  losses             StockLoss[]
  sales              Sale[]
  users              User[]
  transfers          Transfer[]
}

model User {
  id                 String              @id @default(cuid())
  name               String
  role               Role                @default(PARTNER)
  pin                String
  commissionPct      Float               @default(0)
  canTransfer        Boolean             @default(false)
  active             Boolean             @default(true)
  createdAt          DateTime            @default(now())
  cedula             String?             @unique
  tenantId           String?
  isAdmin            Boolean             @default(false)
  email              String?             @unique
  resetToken         String?
  resetTokenExp      DateTime?
  commissionPayments CommissionPayment[]
  deliveries         Delivery[]
  returns            StockReturn[]
  losses             StockLoss[]
  sales              Sale[]
  tenant             Tenant?             @relation(fields: [tenantId], references: [id])
  transfersFrom      Transfer[]          @relation("TransferFrom")
  transfersTo        Transfer[]          @relation("TransferTo")
}

model Product {
  id            String     @id @default(cuid())
  name          String
  reference     String
  costPrice     Int
  salePrice     Int
  active        Boolean    @default(true)
  createdAt     DateTime   @default(now())
  partnerPrice  Int        @default(0)
  tenantId      String?
  boxCost       Int?
  unitsPerBox   Int?
  businessPrice  Int        @default(0)
  businessPrice2 Int        @default(0)
  businessPrice3 Int        @default(0)
  deliveries     Delivery[]
  purchases      Purchase[]
  returns        StockReturn[]
  losses         StockLoss[]
  tenant        Tenant?    @relation(fields: [tenantId], references: [id])
  sales         Sale[]
  transfers     Transfer[]

  @@unique([tenantId, reference])
}

model Purchase {
  id        String   @id @default(cuid())
  tenantId  String?
  productId String
  quantity  Int
  unitCost  Int
  totalCost Int
  supplier  String?
  date      DateTime
  notes     String?
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id])
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])

  @@index([tenantId, productId])
}

model Delivery {
  id        String   @id @default(cuid())
  partnerId String
  productId String
  quantity  Int
  date      DateTime
  notes     String?
  createdAt DateTime @default(now())
  tenantId  String?
  partner   User     @relation(fields: [partnerId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])
}

/// Devolución de un socio a la bodega del dueño (inverso de una entrega)
model StockReturn {
  id        String   @id @default(cuid())
  tenantId  String?
  partnerId String
  productId String
  quantity  Int
  date      DateTime
  notes     String?
  createdAt DateTime @default(now())
  partner   User     @relation(fields: [partnerId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])

  @@index([tenantId, partnerId, productId])
}

/// Pérdida de inventario (botellas quebradas, etc.), desde la bodega (partnerId null) o desde un socio
model StockLoss {
  id              String   @id @default(cuid())
  tenantId        String?
  productId       String
  partnerId       String?
  quantity        Int
  unitCost        Int
  /// Porcentaje del costo que asume el socio (se descuenta de su comisión); el resto lo asume el negocio
  partnerSharePct Int      @default(0)
  date            DateTime
  notes           String?
  createdAt       DateTime @default(now())
  product         Product  @relation(fields: [productId], references: [id])
  partner         User?    @relation(fields: [partnerId], references: [id])
  tenant          Tenant?  @relation(fields: [tenantId], references: [id])

  @@index([tenantId, productId])
  @@index([tenantId, partnerId])
}

model Sale {
  id                    String     @id @default(cuid())
  partnerId             String
  productId             String
  quantity              Int
  date                  DateTime
  receiptImage          String?
  notes                 String?
  status                SaleStatus @default(PENDING)
  createdAt             DateTime   @default(now())
  tenantId              String?
  costPriceSnapshot     Int?
  partnerPriceSnapshot  Int?
  salePriceSnapshot     Int?
  businessPriceSnapshot  Int?
  businessPrice2Snapshot Int?
  businessPrice3Snapshot Int?
  clientType             ClientType @default(CONSUMER)
  partner               User       @relation(fields: [partnerId], references: [id])
  product               Product    @relation(fields: [productId], references: [id])
  tenant                Tenant?    @relation(fields: [tenantId], references: [id])
}

model Transfer {
  id            String   @id @default(cuid())
  tenantId      String?
  fromPartnerId String
  toPartnerId   String
  productId     String
  quantity      Int
  date          DateTime
  notes         String?
  createdAt     DateTime @default(now())
  fromPartner   User     @relation("TransferFrom", fields: [fromPartnerId], references: [id])
  toPartner     User     @relation("TransferTo",   fields: [toPartnerId],   references: [id])
  product       Product  @relation(fields: [productId], references: [id])
  tenant        Tenant?  @relation(fields: [tenantId],  references: [id])
}

model CommissionPayment {
  id               String   @id @default(cuid())
  partnerId        String
  amount           Int
  paymentReference String?
  date             DateTime
  createdAt        DateTime @default(now())
  tenantId         String?
  partner          User     @relation(fields: [partnerId], references: [id])
  tenant           Tenant?  @relation(fields: [tenantId], references: [id])
}

enum Role {
  OWNER
  PARTNER
}

enum SaleStatus {
  PENDING
  CONFIRMED
  REJECTED
}

enum ClientType {
  CONSUMER
  BUSINESS
  BUSINESS_2
  BUSINESS_3
}
